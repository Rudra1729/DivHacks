# Solana stamps (Rudra)
# fake keeps stamps in memory, real mints on devnet
SOLANA_MODE=fake
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ISSUER_KEYPAIR_PATH=.keys/issuer.json
# printed by npm run solana:setup
COLLECTION_HARLEM=
COLLECTION_MORNINGSIDE=
# metadata pages hosted by the API server; the stamp URI is METADATA_BASE_URL/<decisionId>
METADATA_BASE_URL=http://localhost:3000/metadata
# set to true to make every mint fail (Solana-failure test)
SOLANA_FORCE_FAIL=false

# XRPL payments (Tanish)
# fake keeps balances in memory, real pays on XRPL testnet
XRPL_MODE=fake
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# RLUSD normally, XRP only as a fallback if RLUSD setup is blocked
XRPL_ASSET=RLUSD
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY=524C555344000000000000000000000000000000
# printed by npm run xrpl:setup. Agent key only. The treasury key goes in .env.guardian, never here.
AGENT_SEED=

# Grok payout agent (Arundathi)
# Leave GROK_API_KEY empty and the agent pays each place its base reward.
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_ENDPOINT=https://api.x.ai/v1/chat/completions
