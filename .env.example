# Solana stamps (Rudra)
# fake keeps stamps in memory, real mints on devnet
SOLANA_MODE=fake
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ISSUER_KEYPAIR_PATH=.keys/issuer.json
# printed by npm run solana:setup
COLLECTION_HARLEM=
COLLECTION_MORNINGSIDE=
# metadata pages hosted by the API server; the stamp URI is METADATA_BASE_URL/<decisionId>
METADATA_BASE_URL=http://localhost:3000/metadata
# set to true to make every mint fail (Solana-failure test)
SOLANA_FORCE_FAIL=false

# XRPL payments (Tanish)
# fake keeps balances in memory, real pays on XRPL testnet
XRPL_MODE=fake
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# RLUSD normally, XRP only as a fallback if RLUSD setup is blocked
XRPL_ASSET=RLUSD
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY=524C555344000000000000000000000000000000
# printed by npm run xrpl:setup. Agent key only. The treasury key goes in .env.guardian, never here.
AGENT_SEED=

# Grok payout agent (Arundathi)
# Leave GROK_API_KEY empty and the agent pays each place its base reward.
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_ENDPOINT=https://api.x.ai/v1/chat/completions
# Scales every base reward before Grok sees it, e.g. 0.1 pays about a tenth.
# Use a small value for test runs so they barely touch the daily cap. Leave empty for 1.
REWARD_SCALE=

# Location plausibility checks (Sentinel)
# on requires a GPS trail with every submission and blocks locations that never
# move, look typed in, teleport, or are shared by many wallets. off skips them.
LOCATION_CHECKS=on
# on: cultural visits pay RLUSD too. off (default): cultural visits earn only
# the Solana stamp, and only civic bounties pay RLUSD.
CULTURAL_REWARDS=off

# Email OTP auth + per-user custodial wallets (Junaid)
# fake logs the code to the console instead of emailing it, so the app
# runs and is testable with no email provider configured
EMAIL_MODE=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# signs session tokens issued on login. Required, any long random string.
SESSION_SECRET=
# encrypts every user's custodial Solana keypair and XRPL seed at rest.
# Required, any long random string. Losing it makes every stored wallet
# secret unrecoverable, so back it up like a real credential.
WALLET_ENCRYPTION_KEY=
