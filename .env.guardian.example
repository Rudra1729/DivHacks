# Treasury guardian. This file is for the guardian process only.
# Copy to .env.guardian. Never put TREASURY_SEED in the server .env,
# and never put AGENT_SEED here: the guardian refuses to start with it.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY=524C555344000000000000000000000000000000
# secret key of the treasury wallet
TREASURY_SEED=
# public address of the agent wallet being topped up
AGENT_ADDRESS=

# Optional, defaults shown
# GUARDIAN_INTERVAL_SECONDS=180
# GUARDIAN_TARGET_BALANCE=10
# how far back to look at the agent's activity
# GUARDIAN_WINDOW_MINUTES=30
# hold the top-up if the agent paid out more than this in the window
# GUARDIAN_MAX_WINDOW_SPEND=30
# hold the top-up if any single payment is above this
# GUARDIAN_MAX_SINGLE_PAYMENT=5
# comma separated. If set, paying any other address holds the top-up
# GUARDIAN_KNOWN_RECIPIENTS=
