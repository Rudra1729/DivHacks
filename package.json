{
  "name": "webpass-nyc-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WebPass NYC backend: API, Sentinel verification, storage, agent, policy, XRPL payments, Solana stamps.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest",
    "test:e2e": "jest tests/e2e",
    "db:reset": "node -e \"const fs=require('fs');const p=process.env.DB_PATH||'webpass.sqlite';for (const f of [p,p+'-wal',p+'-shm']) fs.rmSync(f,{force:true});console.log('Deleted local database:',p);\"",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "live:check": "tsx --env-file=.env scripts/live/run.ts",
    "live:check:dry": "tsx --env-file=.env scripts/live/run.ts --fake",
    "solana:setup": "tsx scripts/solana/setup.ts",
    "solana:mint-test": "tsx scripts/solana/mintTest.ts",
    "solana:transfer-test": "tsx scripts/solana/transferTest.ts",
    "xrpl:setup": "tsx scripts/xrpl/setup.ts",
    "xrpl:pay-test": "tsx --env-file=.env scripts/xrpl/payTest.ts",
    "xrpl:recycle": "tsx scripts/xrpl/recycle.ts",
    "grok:try": "tsx --env-file=.env scripts/grok/try.ts",
    "guardian": "tsx --env-file=.env.guardian guardian/index.ts",
    "guardian:once": "tsx --env-file=.env.guardian guardian/index.ts --once"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "xrpl": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^11.1.0"
    },
    "@xrplf/isomorphic": "1.0.1",
    "ripple-address-codec": "5.0.0"
  }
}
