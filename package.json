{
  "name": "webpass-nyc-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WebPass NYC backend: API, Sentinel verification, storage, agent, policy, XRPL payments, Solana stamps.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "solana:setup": "tsx scripts/solana/setup.ts",
    "solana:mint-test": "tsx scripts/solana/mintTest.ts",
    "solana:transfer-test": "tsx scripts/solana/transferTest.ts"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "xrpl": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "dotenv": "^18.0.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^11.1.0"
    },
    "@xrplf/isomorphic": "1.0.1",
    "ripple-address-codec": "5.0.0"
  }
}
